# ===== 元宝搜索（腾讯云 wsa / SearchPro）=====
# 控制台取密钥：https://console.cloud.tencent.com/cam/capi
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
# 接入地域，可不填。填了就带上 X-TC-Region
TENCENTCLOUD_REGION=

# ===== 检索参数 =====
# 0=公开网页  1=优质权威垂直信源  2=混合（推荐，权威度字段 authority_level 需旗舰版）
WSA_MODE=2
# 10 / 20 / 30 / 40 / 50
WSA_CNT=10
# 时效过滤，可选：d7 / m3 / y2 / 2026-08-20 / 2026-08-20,2026-08-30。留空=不限
WSA_FRESHNESS=
# 可选垂直领域：gov / news / acad / finance。留空=不限
WSA_INDUSTRY=

# ===== 检索层选择 =====
# auto = 有密钥走元宝搜索，无密钥走离线样例
# wsa  = 强制真实接口（无密钥直接报错，演示时务必用这个）
# mock = 强制离线样例
PROVIDER=auto

# ===== 表达层 / 语义判定层（可选，OpenAI 兼容）=====
# 配了模型，姿态判定走语义；没配就自动用词典法（app/stance.py），链路照常跑完
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=25

# 姿态判定引擎：auto = 有模型走语义、没模型走词典；semantic = 强制语义；lexicon = 强制词典
STANCE_ENGINE=auto

# ===== 服务 =====
HOST=127.0.0.1
PORT=8765
